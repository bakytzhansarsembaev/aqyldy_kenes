[POST] data: {'answer': '', 'tag': 'task_problems', 'prediction': 0.7, 'mode': True, 'close_session': False, 'session_id': '45fdc909-950f-4a4f-af54-5355e09597a9', 'pupil_id': 1113341, 'sender_type': 'pupil', 'full_context': '[{"date":"2026-02-17 15:36:53","text":"Айжас, жарайсың!\\nБүгінгі күннің тапсырмалары орындалды!\\nЕнді ертең дәл осылай жасау керек!\\n\\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\\n","sender_type":"Bot"},{"date":"2026-02-18 18:42:58","text":"Айжас, сізге маңызды хабарлама!\\nТапсырмаларыңыз әлі орындалмаған. Бүгін 00:00-ге дейін аяқтауға уақыт бар.\\nКішкене күш салып, алға жылжып көріңіз!\\n📚 Егер үлгермесеңіз, заморозка қосып алыңыз.\\nЖеңіс сіздің қолыңызда! 💡\\n","sender_type":"Bot"},{"date":"2026-02-18 20:41:42","text":"Айжас АСЕТ, бүгінгі тапсырмаң толық аяқталмапты. Есептер қиын болса,  4 қадам бойынша менторларың көмек беретінін ұмытпа!🤗💫","sender_type":"Bot"},{"date":"2026-02-18 20:42:48","text":"Айжас АСЕТ, бүгінгі тапсырмаң толық аяқталмапты. Есептер қиын болса,  4 қадам бойынша менторларың көмек беретінін ұмытпа!🤗💫","sender_type":"Bot"},{"date":"2026-02-18 22:03:02","text":"Айжас, жарайсың!\\nБүгінгі күннің тапсырмалары орындалды!\\nЕнді ертең дәл осылай жасау керек!\\n\\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\\n","sender_type":"Bot"},{"date":"2026-02-19 18:38:24","text":"Құрметті Айжас!\\nСіздің бүгінгі тапсырмаңыз әлі де аяқталмады.\\n00:00-ге дейін аяқтап үлгеріңіз! Уақытыңызды тиімді пайдаланып, тапсырмаларды орындап, жетістіктерге бірге жетейік!\\n🚀 Егер белгіленген уақытқа дейін тапсырманы орындай алмасаңыз, бүгінгі күн үшін заморозка қосып алыңыз.\\nКүшіңізді жинап, іске кірісейік! 💪\\n","sender_type":"Bot"},{"date":"2026-02-19 19:05:13","text":"Айжас, жарайсың!\\nБүгінгі күннің тапсырмалары орындалды!\\nЕнді ертең дәл осылай жасау керек!\\n\\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\\n","sender_type":"Bot"}]', 'context': 'Bot: Айжас, жарайсың!\nБүгінгі күннің тапсырмалары орындалды!\nЕнді ертең дәл осылай жасау керек!\n\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\n\n Bot: Айжас, сізге маңызды хабарлама!\nТапсырмаларыңыз әлі орындалмаған. Бүгін 00:00-ге дейін аяқтауға уақыт бар.\nКішкене күш салып, алға жылжып көріңіз!\n📚 Егер үлгермесеңіз, заморозка қосып алыңыз.\nЖеңіс сіздің қолыңызда! 💡\n\n Bot: Айжас АСЕТ, бүгінгі тапсырмаң толық аяқталмапты. Есептер қиын болса,  4 қадам бойынша менторларың көмек беретінін ұмытпа!🤗💫\n Bot: Айжас АСЕТ, бүгінгі тапсырмаң толық аяқталмапты. Есептер қиын болса,  4 қадам бойынша менторларың көмек беретінін ұмытпа!🤗💫\n Bot: Айжас, жарайсың!\nБүгінгі күннің тапсырмалары орындалды!\nЕнді ертең дәл осылай жасау керек!\n\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\n\n Bot: Құрметті Айжас!\nСіздің бүгінгі тапсырмаңыз әлі де аяқталмады.\n00:00-ге дейін аяқтап үлгеріңіз! Уақытыңызды тиімді пайдаланып, тапсырмаларды орындап, жетістіктерге бірге жетейік!\n🚀 Егер белгіленген уақытқа дейін тапсырманы орындай алмасаңыз, бүгінгі күн үшін заморозка қосып алыңыз.\nКүшіңізді жинап, іске кірісейік! 💪\n\n Bot: Айжас, жарайсың!\nБүгінгі күннің тапсырмалары орындалды!\nЕнді ертең дәл осылай жасау керек!\n\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\n', 'question': '8', 'modified_message_time': '2026-02-19 14:06:00', 'session_context': '[{"date":"2026-02-19 19:06:45","text":"8","sender_type":"pupil"}]', 'is_smart_suggestion': False}
