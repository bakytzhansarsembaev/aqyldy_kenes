[POST] data: {'answer': '', 'tag': 'task_problems', 'prediction': 0.85, 'mode': True, 'close_session': False, 'session_id': '3b2fc6c2-6126-4e3c-94d6-d5fc0b2f93ab', 'pupil_id': 545300, 'sender_type': 'pupil', 'full_context': '[{"date":"2026-02-17 21:30:43","text":"Кейіпкерлер – сіздің білім жолыңыздағы белсенділігіңізге байланысты дамып отыратын сенімді серіктеріңіз. Оларды кезең-кезеңімен жетілдіріп, жаңа кейіпкерлердің құлпын ашуға болады.\\nЕскерту!\\nКейіпкер сатып алуға Монета 🪙 жеткіліксіз болса, Алмаздарды 💎 кейіпкерді дамытуға қолдана аласыз. Бірақ қолданылған алмаздар кері қайтарылмайды.\\nБілім жолындағы серіктеріңіз сізге тек сәттілік сыйласын! 🤗\\n","sender_type":"mentor"},{"date":"2026-02-17 21:31:03","text":"Алмаз 💎 бен Ментор көмегі 👩🏻\u200d🏫 ақылы түрде тіркелген оқушыларға қолжетімді. Ақылы тіркелгіңіз келсе, ата-анаңыздың нөмерін қалдырсаңыз, менеджерлер байланысатын болады, жақсы ма? 😊\\n","sender_type":"mentor"},{"date":"2026-02-18 13:39:10","text":"Бұл жаңа тапсырма. Шешу жолы басқаша болуы мүмкін, сондықтан видеотүсіндірмені қарап алған дұрыс","sender_type":"Bot"},{"date":"2026-02-18 13:41:36","text":"Аяна, жарайсың!\\nБүгінгі күннің тапсырмалары орындалды!\\nЕнді ертең дәл осылай жасау керек!\\n\\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\\n","sender_type":"Bot"},{"date":"2026-02-19 18:29:14","text":"Аяна, сізге маңызды хабарлама!\\nТапсырмаларыңыз әлі орындалмаған. Бүгін 00:00-ге дейін аяқтауға уақыт бар.\\nКішкене күш салып, алға жылжып көріңіз!\\n📚 Егер үлгермесеңіз, заморозка қосып алыңыз.\\nЖеңіс сіздің қолыңызда! 💡\\n","sender_type":"Bot"},{"date":"2026-02-19 19:20:12","text":"Аяна, жарайсың!\\nБүгінгі күннің тапсырмалары орындалды!\\nЕнді ертең дәл осылай жасау керек!\\n\\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\\n","sender_type":"Bot"},{"date":"2026-02-19 19:20:27","text":"10","sender_type":"pupil"}]', 'context': 'Mentor: Кейіпкерлер – сіздің білім жолыңыздағы белсенділігіңізге байланысты дамып отыратын сенімді серіктеріңіз. Оларды кезең-кезеңімен жетілдіріп, жаңа кейіпкерлердің құлпын ашуға болады.\nЕскерту!\nКейіпкер сатып алуға Монета 🪙 жеткіліксіз болса, Алмаздарды 💎 кейіпкерді дамытуға қолдана аласыз. Бірақ қолданылған алмаздар кері қайтарылмайды.\nБілім жолындағы серіктеріңіз сізге тек сәттілік сыйласын! 🤗\n\n Mentor: Алмаз 💎 бен Ментор көмегі 👩🏻\u200d🏫 ақылы түрде тіркелген оқушыларға қолжетімді. Ақылы тіркелгіңіз келсе, ата-анаңыздың нөмерін қалдырсаңыз, менеджерлер байланысатын болады, жақсы ма? 😊\n\n Bot: Бұл жаңа тапсырма. Шешу жолы басқаша болуы мүмкін, сондықтан видеотүсіндірмені қарап алған дұрыс\n Bot: Аяна, жарайсың!\nБүгінгі күннің тапсырмалары орындалды!\nЕнді ертең дәл осылай жасау керек!\n\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\n\n Bot: Аяна, сізге маңызды хабарлама!\nТапсырмаларыңыз әлі орындалмаған. Бүгін 00:00-ге дейін аяқтауға уақыт бар.\nКішкене күш салып, алға жылжып көріңіз!\n📚 Егер үлгермесеңіз, заморозка қосып алыңыз.\nЖеңіс сіздің қолыңызда! 💡\n\n Bot: Аяна, жарайсың!\nБүгінгі күннің тапсырмалары орындалды!\nЕнді ертең дәл осылай жасау керек!\n\nБүгінгі күннің тапсырмаларын қалай бағалайсың?\n\n Pupil: 10', 'question': '10', 'modified_message_time': '2026-02-19 14:20:00', 'session_context': '[{"date":"2026-02-19 19:20:27","text":"10","sender_type":"pupil"}]', 'is_smart_suggestion': False}
