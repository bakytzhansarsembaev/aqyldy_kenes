[POST] data: {'answer': '', 'tag': 'freezing', 'prediction': 0.85, 'mode': True, 'close_session': False, 'session_id': '0ce7a941-65f0-42e8-a5b7-23a920251c62', 'pupil_id': 1435648, 'sender_type': 'parent', 'full_context': '[{"date":"2026-02-19 19:20:07","text":"Құрметті ата-ана!\\nАян үшін тапсырманы орындау маңызды, ал сіздің қолдауыңыз – оның мотивациясы!\\n💡 00:00-ге дейін бүгінгі тапсырма орындалуы керек.\\nЕгер үлгермесе, \\"заморозка\\" мүмкіндігін қолдануды ұмытпаңыздар.\\nБірге жетістікке жетейік! 🚀\\n","sender_type":"Bot"},{"date":"2026-02-19 20:32:12","text":"Құрметті ата-ана!\\r\\nАян ЫМРАЙМХАНУЛЫ, тапсырманы аяқтап қалды ма? 00:00 ге аз уақыт қалды ✏️","sender_type":"Bot"},{"date":"2026-02-19 20:56:09","text":"кеш жарық","sender_type":"parent"},{"tag":"greeting","date":"2026-02-19 20:56:19","text":"Сәлем! «Кеш жарық» — кешкі амандасу. Сіз біреуге сәлемдескіңіз келе ме, әлде басқа бір нәрсені айтқыңыз келе ме?","sender_type":"ML"},{"date":"2026-02-19 20:56:48","text":"менің ұлым Арысбек Аян Ыбраймханұлының сабағын мына тел номерге ауыстырады болама? 8775 279 57 91","sender_type":"parent"},{"date":"2026-02-19 21:02:02","text":"Оқушы номері өзгертілді. Кіріп көре аласыздар ма?","sender_type":"mentor"},{"date":"2026-02-19 21:29:03","text":"қайдан көреміз","sender_type":"parent"}]', 'context': 'Bot: Құрметті ата-ана!\nАян үшін тапсырманы орындау маңызды, ал сіздің қолдауыңыз – оның мотивациясы!\n💡 00:00-ге дейін бүгінгі тапсырма орындалуы керек.\nЕгер үлгермесе, "заморозка" мүмкіндігін қолдануды ұмытпаңыздар.\nБірге жетістікке жетейік! 🚀\n\n Bot: Құрметті ата-ана!\r\nАян ЫМРАЙМХАНУЛЫ, тапсырманы аяқтап қалды ма? 00:00 ге аз уақыт қалды ✏️\n Parent: кеш жарық\n ML: Сәлем! «Кеш жарық» — кешкі амандасу. Сіз біреуге сәлемдескіңіз келе ме, әлде басқа бір нәрсені айтқыңыз келе ме?\n Parent: менің ұлым Арысбек Аян Ыбраймханұлының сабағын мына тел номерге ауыстырады болама? 8775 279 57 91\n Mentor: Оқушы номері өзгертілді. Кіріп көре аласыздар ма?\n Parent: қайдан көреміз', 'question': '8705 839 0292 тел номері ауылда қалды, оқушы Алматыда', 'modified_message_time': '2026-02-19 16:29:00', 'session_context': '[{"date":"2026-02-19 21:29:03","text":"қайдан көреміз","sender_type":"parent"}]', 'is_smart_suggestion': False}
